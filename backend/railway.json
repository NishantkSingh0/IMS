{
  "$schema": "https://json.schemastore.org/railway",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "sh -c \"python manage.py collectstatic --noinput && gunicorn bms_api.wsgi:application --bind 0.0.0.0:$PORT --workers 4\"",
    "healthcheckPath": "/admin/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}