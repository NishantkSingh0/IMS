# Security
SECRET_KEY=your-secret-key-minimum-32-characters-long-for-production
DEBUG=False

# Application
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (use either DATABASE_URL or individual DB_* variables)
DATABASE_URL=postgres://postgres:password@localhost:5432/IMS?sslmode=disable
# OR
DB_NAME=IMS
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Business Settings
BUSINESS_NAME=Smart Business Management
GST_RATE=18
CURRENCY_SYMBOL=₹
