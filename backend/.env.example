# Security
SECRET_KEY=django-insecure-dev-key-for-development-only-min-32-chars-long
DEBUG=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Application - Add your deployed domains here
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app,ims-oaknore.vercel.app

# Database (use either DATABASE_URL or individual DB_* variables)
DATABASE_URL=postgres://postgres:password@localhost:5432/IMS?sslmode=disable
# OR
DB_NAME=IMS
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/1

# CORS - Add your frontend domains here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://ims-oaknore.vercel.app

# Business Settings
BUSINESS_NAME=Smart Business Management
GST_RATE=18
CURRENCY_SYMBOL=₹

# Mock Data User Passwords
ADMIN_PASS=O$1234567890
MANAGER_PASS=O$1234567890
MANAGER2_PASS=O$1234567890
